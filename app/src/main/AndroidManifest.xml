<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================================================================= -->
    <!-- 1. РАЗРЕШЕНИЯ ДЛЯ РАБОТЫ ЭКРАНА И СИСТЕМНОЙ БЛОКИРОВКИ (LOCKSCREEN) -->
    <!-- ================================================================= -->
    <!-- Пробуждение процессора и удерживание экрана зажженным -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Перехват и снятие экрана блокировки без ввода пароля/отпечатка -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- Полноэкранные интенты поверх экрана блокировки (Android 10+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Отображение всплывающих окон и поверх других окон (OriginOS / FuntouchOS) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ================================================================= -->
    <!-- 2. РАЗРЕШЕНИЯ ДЛЯ ТОЧНЫХ БУДИЛЬНИКОВ И ПЕРЕЗАГРУЗКИ              -->
    <!-- ================================================================= -->
    <!-- Точные будильники для Android 12+ (Target API 31+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Безусловное точное планирование для приложений-часов (Android 13+) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Автоперепланирование будильников после перезагрузки телефона -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ================================================================= -->
    <!-- 3. УВЕДОМЛЕНИЯ, СЛУЖБЫ И АППАРАТНЫЕ ФУНКЦИИ                        -->
    <!-- ================================================================= -->
    <!-- Показ уведомления будильника (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Фоновая служба срабатывания -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Вибрация -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PureClock"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PureClock">

        <!-- Главное окно приложения -->
        <activity
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Единая точка входа для лаунчера -->
        <activity-alias
            android:name=".MainActivityAliasDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="PureClock"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            ЭКРАН БУДИЛЬНИКА:
            Строгие флаги launchMode="singleInstance" и excludeFromRecents="true"
            гарантируют, что окно не сцепляется с другими Activity и выходит поверх сканера.
        -->
        <activity
            android:name=".alarm.AlarmAlertActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Фоновая служба с типом Special Use -->
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaPlayback" />

        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Alarm Clock Notification Service" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_TICK" />
                <action android:name="com.necromagik.pureclock.ACTION_UPDATE_LIVE_ICON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>